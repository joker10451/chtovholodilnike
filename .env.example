# Скопируйте этот файл в .env.local и заполните. .env.local не попадает в git.

# ——— Нейросеть (только на сервере, в браузер не попадает) ———
# gemini — бесплатный тариф Google, claude — платный Anthropic
AI_PROVIDER=gemini
# Ключ из https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Необязательно: другая модель Gemini
# GEMINI_MODEL=gemini-3.5-flash
# Если AI_PROVIDER=claude:
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Код доступа к нейросети. Придумайте любой и введите его в приложении: Настройки → Нейросеть.
# На Vercel без него функция не запустится, чтобы чужие не тратили ваш лимит.
APP_ACCESS_CODE=

# ——— Синхронизация двух телефонов (необязательно) ———
# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
